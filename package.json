{
  "name": "lesson-generator8",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:release": "playwright test -c playwright.release.config.ts",
    "test:engine": "vitest run src/engine",
    "test:standards-contract": "vitest run src/engine/standard-optional-contract.test.ts src/engine/blueprint/resolveBlueprintContent.test.ts src/engine/analysis-and-blueprint.test.ts",
    "dist:check": "node ./scripts/check-dist-bundle.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run dist:check",
    "verify:release": "npm run typecheck && npm run build && npm run test && npm run test:e2e:release",
    "ai:server": "node server/material-analysis-server.mjs",
    "dev:teacher": "vite --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.4.1",
    "express": "^4.22.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "openai": "^5.23.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "pptx-parser": "^1.1.7-beta.9",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "tesseract.js": "^7.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.0-rc.9"
  },
  "engines": {
    "node": ">=20.20.0 <23",
    "npm": ">=10"
  }
}
